package com.info.tod;

import javafx.application.Application;
import javafx.geometry.Insets;
import javafx.scene.Scene;
import javafx.scene.control.*;
import javafx.scene.layout.*;
import javafx.stage.Stage;

public class MainApp extends Application {

    private ListView<Task> listView = new ListView<>();
    private Label pointsLabel = new Label("Points: 0");

    @Override
    public void start(Stage stage) {

        TextField input = new TextField();
        input.setPromptText("Enter your task...");

        Button addBtn = new Button("Add");
        Button completeBtn = new Button("Complete");
        Button deleteBtn = new Button("Delete");

        addBtn.setOnAction(e -> {
            try {
                TaskDAO.addTask(input.getText());
                input.clear();
                refresh();
            } catch (Exception ex) {
                ex.printStackTrace();
            }
        });

        completeBtn.setOnAction(e -> {
            Task t = listView.getSelectionModel().getSelectedItem();
            if (t != null && !t.getStatus().equals("Completed")) {
                try {
                    TaskDAO.completeTask(t.getId());
                    refresh();
                } catch (Exception ex) {
                    ex.printStackTrace();
                }
            }
        });

        deleteBtn.setOnAction(e -> {
            Task t = listView.getSelectionModel().getSelectedItem();
            if (t != null) {
                try {
                    TaskDAO.deleteTask(t.getId());
                    refresh();
                } catch (Exception ex) {
                    ex.printStackTrace();
                }
            }
        });

        HBox buttonBox = new HBox(10, addBtn, completeBtn, deleteBtn);
        VBox root = new VBox(15, input, buttonBox, listView, pointsLabel);

        root.setPadding(new Insets(20));

        Scene scene = new Scene(root, 450, 500);

        stage.setTitle("To-Do App (Gamified)");
        stage.setScene(scene);
        stage.show();

        refresh();
    }

    private void refresh() {
        try {
            listView.getItems().setAll(TaskDAO.getTasks());
            pointsLabel.setText("Points: " + TaskDAO.getTotalPoints());
        } catch (Exception e) {
            e.printStackTrace();
        }
    }

    public static void main(String[] args) {
        launch();
    }
}